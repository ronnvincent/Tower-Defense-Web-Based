# Copy to `.env.local` and fill in — `.env*` files are git-ignored.
#
# Only the two VITE_ variables below are read by the game, and both are safe to
# ship to a browser: the anon key can do nothing but call the seven functions
# the migration grants to `anon`.
#
# NEVER put the service-role key here, in a `?key=` link, or anywhere else that
# reaches a browser. It bypasses RLS and owns the whole database.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# With neither set, the game talks to the local stand-in ledger:
#   npm run dev:cloud
