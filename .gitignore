# Dependencies — installed by the host (Vercel runs `npm install` on a clean checkout).
node_modules/

# Build output — produced by `npm run build`.
dist/

# Local tool caches
.vite/
.vitest-cache/
coverage/

# Vercel CLI metadata
.vercel/

# Scratch research kept out of the repository (7.5 MB of reference screenshots)
image-search/
uploads/

# Python bytecode from the asset pipeline
__pycache__/
*.pyc

# Editor / OS noise
.DS_Store
Thumbs.db
*.log

# Local ledger stand-in state (server/cloud-dev.mjs) — scratch, not a database
.dev-data/

# Supabase credentials. The anon key is public by design and safe to build in,
# but the file also tempts people to paste the service-role key, which is not —
# so no .env file is ever committed. See .env.example for the two names.
.env
.env.local
.env.*.local
